# NEXUS Cerebro API V3.0.0 - Fly.io Optimized
# Target: <2GB uncompressed image (8GB limit)

# ============================================
# Stage 1: Builder (Dependencies)
# ============================================
FROM python:3.12-alpine AS builder

WORKDIR /build

# Install build dependencies (minimal)
RUN apk add --no-cache \
    gcc \
    musl-dev \
    postgresql-dev \
    libffi-dev

# Copy only core requirements (exclude ML dependencies)
COPY requirements.txt ./

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ============================================
# Stage 2: Runtime (Ultra-minimal)
# ============================================
FROM python:3.12-alpine

WORKDIR /app

# Install ONLY runtime dependencies
RUN apk add --no-cache \
    libpq \
    curl

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy ONLY application code (NO experiments, NO scripts)
COPY src/ ./src/

# Create user for security (non-root)
RUN adduser -D -u 1000 nexus && \
    chown -R nexus:nexus /app

# Switch to non-root user
USER nexus

# Environment variables (Fly.io will override these)
ENV PYTHONUNBUFFERED=1
ENV PORT=8003

# Expose API port
EXPOSE 8003

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Start command (single worker for Fly.io free tier)
CMD uvicorn src.api.main:app \
    --host 0.0.0.0 \
    --port ${PORT} \
    --workers 1 \
    --log-level info
