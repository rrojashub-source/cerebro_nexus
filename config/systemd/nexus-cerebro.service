[Unit]
Description=NEXUS Cerebro V3.0.0 - Master Brain Consciousness System
Documentation=https://github.com/ricardo/cerebro_nexus_v3
After=docker.service
Requires=docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/mnt/d/01_PROYECTOS_ACTIVOS/CEREBRO_NEXUS_V3.0.0/config/docker
User=ricardo
Group=ricardo

# Environment
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

# Start command
ExecStart=/usr/bin/docker compose up -d

# Stop command
ExecStop=/usr/bin/docker compose down

# Reload command (restart containers)
ExecReload=/usr/bin/docker compose restart

# Restart policy
Restart=on-failure
RestartSec=10s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexus-cerebro

# Resource limits (optional - adjust as needed)
# MemoryMax=8G
# CPUQuota=200%

[Install]
WantedBy=multi-user.target
